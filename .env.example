# Скопировать в .env и заполнить. Файл .env в репозиторий не попадает.

# GigaChat: ключ авторизации из личного кабинета (строка Authorization key)
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Pro
# Путь к сертификату НУЦ Минцифры (нужен для HTTPS-соединения с GigaChat)
GIGACHAT_CA_BUNDLE=

# YandexGPT (Yandex Cloud AI Studio)
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt/latest

# Открытая модель через Ollama или другой сервер с OpenAI-совместимым API
QWEN_BASE_URL=http://localhost:11434/v1
QWEN_MODEL=
QWEN_API_KEY=

# Цены за 1000 токенов в рублях (ввод / вывод) для подсчёта стоимости. Взять из актуальных тарифов.
GIGACHAT_PRICE_IN=0
GIGACHAT_PRICE_OUT=0
YANDEX_PRICE_IN=0
YANDEX_PRICE_OUT=0
QWEN_PRICE_IN=0
QWEN_PRICE_OUT=0
